{
  "name": "taiken-backend",
  "version": "3.0.0",
  "private": true,
  "description": "体験生成AI Backend (iOS → Backend → AI API)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start:mock": "AI_PROVIDER=mock node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/index.ts\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test:coverage",
    "token": "node scripts/generate-token.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
