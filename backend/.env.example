# コピーして .env を作成 (.env はgitに入れない)。値の意味は docs/OPERATIONS.md を参照。

# development | production | test
#   production では「APIキー・32文字以上のCLIENT_TOKENS」が無いと起動しない
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# ---- AI ----
# anthropic | mock (mock はAPIキー不要。AIなしで全体を試せる)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_EXPERIENCE=claude-sonnet-5-5
AI_MODEL_CHAT=claude-haiku-5-5
AI_MODEL_RESEARCH=claude-haiku-5-5
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# AIが使えないとき、モックの代替生成でアプリを動かし続けるか
FALLBACK_TO_MOCK=true

# ---- 必要時Web検索 (指示書 §14) ----
# true にしても、iOS側で「必要時のWeb検索」を許可したときだけ使われる
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TOOL_TYPE=web_search_20250305
WEB_SEARCH_MAX_USES=2

# ---- 1日の利用上限 (使いすぎ防止) ----
DAILY_AI_REQUEST_LIMIT=200
DAILY_AI_TOKEN_LIMIT=500000
DAILY_WEB_SEARCH_LIMIT=20
BUDGET_TIME_ZONE=Asia/Tokyo
# 使用量を保存するフォルダ (再起動しても当日の使用量を引き継ぐ)。空なら保存しない
DATA_DIR=./data

# ---- アクセス制御 ----
# iOSアプリに設定するトークン (npm run token で生成)。カンマ区切りで複数可 (ローテーション用)
CLIENT_TOKENS=
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_AI=4
MAX_BODY_BYTES=32768
REQUEST_DEADLINE_MS=50000
